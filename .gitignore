# DeltaFStation .gitignore

# 数据文件夹（默认忽略，按白名单放行）
data/*
data_cache/
!data/strategies/
!data/strategies/*.py
!data/raw/
data/raw/*
!data/raw/symbols_dict_miniqmt.json
!data/raw/symbols_dict_baostock.json
# yfinance 遗留样本已归档到 data/raw/_legacy_yfinance/（不再入库）
data/raw/_legacy_yfinance/
# 复权事件表与落盘元数据：随数据量增长，按白名单只放行目录本身
data/adjust/
data/meta/
data/quality/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 虚拟环境
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# 日志文件
logs/
*.log

# 环境变量
.env
.env.local
.env.*.local

# Flask
instance/
.webassets-cache

# 临时文件
*.tmp
*.temp
.cache/

# 操作系统
Thumbs.db
.DS_Store

# 测试覆盖率
.coverage
htmlcov/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# 其他
*.bak
*.orig

# WorkBuddy AI 工作目录（本地辅助数据，不入库）
.workbuddy-ai/

